# One-shot weekly triage report from eval/query_log.jsonl.
#
# Triggered by weekly-triage.timer (Mondays 09:00 UTC). Install:
#   sudo cp deploy/weekly-triage.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now weekly-triage.timer
#   systemctl list-timers weekly-triage.timer

[Unit]
Description=Ark onboarding bot weekly query triage report
After=network-online.target

[Service]
Type=oneshot
User=arkbot
Group=arkbot
WorkingDirectory=/opt/ark-onboarding-bot
Environment=PATH=/opt/ark-onboarding-bot/.venv/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/opt/ark-onboarding-bot/deploy/run_weekly_triage.sh
