# Fire weekly-triage.service every Monday at 09:00 UTC.
#
# Check schedule: systemctl list-timers weekly-triage.timer
# Run now (smoke test): sudo systemctl start weekly-triage.service

[Unit]
Description=Weekly Ark onboarding bot query triage (Mon 09:00 UTC)

[Timer]
OnCalendar=Mon *-*-* 09:00:00 UTC
Persistent=true

[Install]
WantedBy=timers.target
