# --- Answer generation ---------------------------------------------------
# Which provider generates the answer: pi (Pi Inference gateway) or cursor.
ANSWER_BACKEND=pi

# Pi Inference. Note the host: app.inference.paytm.com is the CONTROL PLANE and
# 404s on completions -- inference lives on api.inference.paytm.com.
PI_API_KEY=
PI_MODEL=qwen/qwen3-32b
# PI_BASE_URL=https://api.inference.paytm.com
# PI_TIMEOUT_SECONDS=60
# PI_MAX_TOKENS=800
# Extra request params, JSON. Merged over the per-model defaults in answer.py
# (qwen3-32b already gets reasoning_effort=none + response_format=json_object).
# PI_EXTRA_PARAMS={"temperature":0}

# --- Cursor backend (ANSWER_BACKEND=cursor) ------------------------------
CURSOR_API_KEY=
CURSOR_MODEL=claude-haiku-4-5
# sdk first on open networks; use cli on corp laptops if SDK hits proxy errors
CURSOR_ANSWER_BACKEND=auto
ASK_TOP_K=8
WARM_ON_STARTUP=1
WARM_AGENT_ON_STARTUP=1
ASK_RETRIEVAL_CACHE=1
ASK_RETRIEVAL_CACHE_SIZE=128
ASK_ANSWER_CACHE=1
ASK_ANSWER_CACHE_SIZE=128

# Shared team access token for the web UI (leave empty to run open locally).
ARK_ACCESS_TOKEN=

# Subpath prefix when served behind the Foundry ingress (leave empty for local dev).
# BASE_PATH=/onboarding-bot

SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=
# Set on corp laptops if Socket Mode fails SSL verify (Python 3.13+ / Zscaler):
# SLACK_SSL_RELAX=1
